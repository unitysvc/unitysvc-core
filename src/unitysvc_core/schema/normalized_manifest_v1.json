{
  "$defs": {
    "ManifestHealth": {
      "additionalProperties": false,
      "description": "A seller-defined readiness check for one service (the agent's ``Health``).\n\n``http``: GET ``path`` on ``port`` (2xx or 3xx passes); ``tcp``: ``port``\naccepts a connection; ``exec``: ``command`` runs in the container and exits\n0. ``port`` defaults to the service's first port. Timing is optional; the\nagent's defaults are period 5 s, timeout 2 s, success 1, failure 3, start\nperiod 60 s.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "failure_threshold": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Threshold"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "period_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Seconds"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "start_period_seconds": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Period Seconds"
        },
        "success_threshold": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Threshold"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "type": {
          "enum": [
            "http",
            "tcp",
            "exec"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ManifestHealth",
      "type": "object"
    },
    "ManifestPersist": {
      "additionalProperties": false,
      "description": "A path in the container whose files outlive the instance (unitysvc/unitysvc#3098).\n\nBefore the service starts the agent restores ``folder`` of ``store`` into the directory, while it runs and\nonce more when it stops it copies new and changed files back (never deleting), and the same files are\nthere at the next start, on this cluster or another. ``store`` is ``storage`` (the instance's enrollment\nfolder, which the platform resolves from the enrollment, so the manifest names no enrollment) or ``home``\n(a folder of the customer's home, which the customer must have granted).",
      "properties": {
        "exclude": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Globs, relative to the directory, left out both ways",
          "title": "Exclude"
        },
        "folder": {
          "description": "Relative folder inside the store, without a leading or trailing slash",
          "title": "Folder",
          "type": "string"
        },
        "gid": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gid"
        },
        "mode": {
          "default": "rw",
          "description": "`rw`: restored and copied back; `ro`: restored only, never copied back",
          "enum": [
            "rw",
            "ro"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "description": "Normalized absolute path inside the container, below /",
          "pattern": "^/.",
          "title": "Path",
          "type": "string"
        },
        "store": {
          "description": "`storage`: the instance's enrollment folder; `home`: a folder of the customer's home",
          "enum": [
            "storage",
            "home"
          ],
          "title": "Store",
          "type": "string"
        },
        "uid": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Owner of the restored files; with gid, or neither",
          "title": "Uid"
        }
      },
      "required": [
        "path",
        "store",
        "folder"
      ],
      "title": "ManifestPersist",
      "type": "object"
    },
    "ManifestResources": {
      "additionalProperties": false,
      "description": "What a service asks for and may use: resource name to Kubernetes quantity.",
      "properties": {
        "limits": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limits"
        },
        "requests": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests"
        }
      },
      "title": "ManifestResources",
      "type": "object"
    },
    "ManifestScratch": {
      "additionalProperties": false,
      "description": "A path in the container that is temporary storage (from a Compose named or anonymous volume mount).\n\nThe cluster gives it an ``emptyDir``: the path exists and is writable, its data survives a container\nrestart but not a replacement of the instance, and it counts against the service's ephemeral storage.",
      "properties": {
        "path": {
          "description": "Normalized absolute path inside the container, below /",
          "pattern": "^/.",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "ManifestScratch",
      "type": "object"
    },
    "ManifestService": {
      "additionalProperties": false,
      "description": "One container of an instance (the agent's ``Service``).",
      "properties": {
        "args": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the image's command",
          "title": "Args"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the image's entrypoint",
          "title": "Command"
        },
        "env": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image": {
          "description": "Digest-pinned image reference",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "name": {
          "description": "A DNS label; the Service name siblings reach it by",
          "title": "Name",
          "type": "string"
        },
        "persist": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ManifestPersist"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directories restored from and copied back to the customer's storage",
          "title": "Persist"
        },
        "ports": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Container ports (TCP)",
          "title": "Ports"
        },
        "replicas": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replicas"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestResources"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scratch": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ManifestScratch"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Temporary storage mounted in the container (an emptyDir each)",
          "title": "Scratch"
        }
      },
      "required": [
        "name",
        "image"
      ],
      "title": "ManifestService",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The compiled instance spec: the agent's ``Manifest``.",
  "properties": {
    "services": {
      "items": {
        "$ref": "#/$defs/ManifestService"
      },
      "minItems": 1,
      "title": "Services",
      "type": "array"
    }
  },
  "required": [
    "services"
  ],
  "title": "NormalizedManifest",
  "type": "object"
}
