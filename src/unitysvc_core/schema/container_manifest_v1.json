        "image": {
          "pattern": "^\\S+@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "ports": {
          "items": {
            "type": "integer"
