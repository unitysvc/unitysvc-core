      "type": "object"
    },
    "ContainerResources": {
      "additionalProperties": false,
      "description": "One replica's allocation. Each tier explicitly budgets CPU, RAM and disk.\n\nA resource given only as a request or limit is copied to the other side.\nExtended resources use integer quantities and equal requests and limits.",
      "properties": {
        "limits": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Limits",
          "type": "object"
        },
        "requests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Requests",
          "type": "object"
        }
      },
      "title": "ContainerResources",
      "type": "object"
    },
    "ContainerService": {
