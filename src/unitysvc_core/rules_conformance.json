{
  "description": "Request-rule condition cases shared by unitysvc-core (unitysvc_core.rules) and apisix-gateways (lib/rules.lua), unitysvc/unitysvc#2947. A case with 'error' must fail to parse, its message containing that text. Any other case must parse and evaluate to 'match' against 'request' (body absent = not JSON) with 'slots' (resolved values by reference; an absent reference uses its ?? default). Copy this file unchanged between the two repos.",
  "version": 1,
  "cases": [
    {"name": "body field equals", "when": "body.type == 'ping'", "request": {"body": {"type": "ping"}}, "match": true},
    {"name": "body field differs", "when": "body.type == 'ping'", "request": {"body": {"type": "pong"}}, "match": false},
    {"name": "nested body field", "when": "body.author.id == '42'", "request": {"body": {"author": {"id": "42"}}}, "match": true},
    {"name": "bracket key in body", "when": "body['user-id'] == 'u'", "request": {"body": {"user-id": "u"}}, "match": true},
    {"name": "bracket and dot are the same lookup", "when": "body['author'].name == 'a'", "request": {"body": {"author": {"name": "a"}}}, "match": true},
    {"name": "missing body field", "when": "body.type == 'ping'", "request": {"body": {}}, "match": false},
    {"name": "missing intermediate object", "when": "body.author.id == '1'", "request": {"body": {"author": "x"}}, "match": false},
    {"name": "body not json", "when": "body.type == 'ping'", "request": {}, "match": false},
    {"name": "body is an array", "when": "body.type == 'ping'", "request": {"body": [{"type": "ping"}]}, "match": false},
    {"name": "number never equals a string", "when": "body.id == '123'", "request": {"body": {"id": 123}}, "match": false},
    {"name": "boolean never equals a string", "when": "body.bot == 'true'", "request": {"body": {"bot": true}}, "match": false},
    {"name": "null never equals a string", "when": "body.x == 'null'", "request": {"body": {"x": null}}, "match": false},
    {"name": "object never matches", "when": "'a' in body.x", "request": {"body": {"x": {"a": "a"}}}, "match": false},
    {"name": "empty string equals empty literal", "when": "body.x == ''", "request": {"body": {"x": ""}}, "match": true},
    {"name": "equality is case sensitive", "when": "body.type == 'Ping'", "request": {"body": {"type": "ping"}}, "match": false},
    {"name": "unicode equality", "when": "body.name == 'Bo Peng - 测试'", "request": {"body": {"name": "Bo Peng - 测试"}}, "match": true},

    {"name": "header lookup", "when": "header['x-github-event'] == 'ping'", "request": {"headers": {"x-github-event": "ping"}}, "match": true},
    {"name": "header names are case insensitive", "when": "header['X-GitHub-Event'] == 'ping'", "request": {"headers": {"X-Github-Event": "ping"}}, "match": true},
    {"name": "header values are case sensitive", "when": "header['x-github-event'] == 'ping'", "request": {"headers": {"x-github-event": "PING"}}, "match": false},
    {"name": "missing header", "when": "header['x-github-event'] == 'ping'", "request": {"headers": {}}, "match": false},
    {"name": "query lookup", "when": "query['hub.mode'] == 'subscribe'", "request": {"query": {"hub.mode": "subscribe"}}, "match": true},
    {"name": "missing query argument", "when": "query['hub.mode'] == 'subscribe'", "request": {"query": {}}, "match": false},
    {"name": "method", "when": "method == 'POST'", "request": {"method": "POST"}, "match": true},
    {"name": "method differs", "when": "method == 'POST'", "request": {"method": "GET"}, "match": false},

    {"name": "ref in literal", "when": "body.type in 'message.created message.updated'", "request": {"body": {"type": "message.created"}}, "match": true},
    {"name": "ref not in literal", "when": "body.type in 'message.created'", "request": {"body": {"type": "channel.updated"}}, "match": false},
    {"name": "empty ref is never in a literal", "when": "body.type in 'abc'", "request": {"body": {"type": ""}}, "match": false},
    {"name": "literal in ref", "when": "'[bot]' in body.sender.login", "request": {"body": {"sender": {"login": "dependabot[bot]"}}}, "match": true},
    {"name": "literal not in ref", "when": "'[bot]' in body.sender.login", "request": {"body": {"sender": {"login": "octocat"}}}, "match": false},
    {"name": "empty literal is never in a ref", "when": "'' in body.x", "request": {"body": {"x": "anything"}}, "match": false},
    {"name": "literal in missing ref", "when": "'a' in body.x", "request": {"body": {}}, "match": false},
    {"name": "double-quoted literal", "when": "body.x == \"it's\"", "request": {"body": {"x": "it's"}}, "match": true},
    {"name": "escaped quote", "when": "body.x == 'it\\'s'", "request": {"body": {"x": "it's"}}, "match": true},
    {"name": "escaped backslash", "when": "body.x == 'a\\\\b'", "request": {"body": {"x": "a\\b"}}, "match": true},
    {"name": "whitespace is insignificant", "when": "  body . type   ==   'ping'  ", "request": {"body": {"type": "ping"}}, "match": true},

    {"name": "customer secret slot", "when": "body.user_id == '${ customer_secrets.DISCORD_WEBHOOK_ID }'", "request": {"body": {"user_id": "123"}}, "slots": {"customer_secrets.DISCORD_WEBHOOK_ID": "123"}, "match": true},
    {"name": "customer secret slot differs", "when": "body.user_id == '${ customer_secrets.DISCORD_WEBHOOK_ID }'", "request": {"body": {"user_id": "124"}}, "slots": {"customer_secrets.DISCORD_WEBHOOK_ID": "123"}, "match": false},
    {"name": "unset secret never matches", "when": "body.user_id == '${ customer_secrets.DISCORD_WEBHOOK_ID ?? }'", "request": {"body": {"user_id": ""}}, "match": false},
    {"name": "empty secret never matches", "when": "body.user_id == '${ customer_secrets.X }'", "request": {"body": {"user_id": ""}}, "slots": {"customer_secrets.X": ""}, "match": false},
    {"name": "secret default applies when unset", "when": "body.v == '${ customer_secrets.X ?? fallback }'", "request": {"body": {"v": "fallback"}}, "match": true},
    {"name": "secret value wins over default", "when": "body.v == '${ customer_secrets.X ?? fallback }'", "request": {"body": {"v": "fallback"}}, "slots": {"customer_secrets.X": "set"}, "match": false},
    {"name": "secret containing a quote is a value, not code", "when": "body.v == '${ customer_secrets.X }'", "request": {"body": {"v": "x' or 'a' == 'a"}}, "slots": {"customer_secrets.X": "x' or 'a' == 'a"}, "match": true},
    {"name": "seller secret slot", "when": "header['x-token'] == '${ secrets.TOKEN }'", "request": {"headers": {"x-token": "t"}}, "slots": {"secrets.TOKEN": "t"}, "match": true},
    {"name": "param slot with in", "when": "'{{ params.marker }}' in body.name", "request": {"body": {"name": "Bo - marker1"}}, "slots": {"params.marker": "marker1"}, "match": true},
    {"name": "ref in param slot", "when": "body.type in '{{ params.types }}'", "request": {"body": {"type": "a"}}, "slots": {"params.types": "a b"}, "match": true},
    {"name": "unset param never matches", "when": "'{{ params.marker }}' in body.name", "request": {"body": {"name": "x"}}, "match": false},
    {"name": "enrollment code slot", "when": "query['code'] == '{{ enrollment.code }}'", "request": {"query": {"code": "ABC"}}, "slots": {"enrollment.code": "ABC"}, "match": true},

    {"name": "secret under in is refused", "when": "body.user_id in '${ customer_secrets.DISCORD_WEBHOOK_URL ?? }'", "error": "may only be compared with '=='"},
    {"name": "secret on the left of in is refused", "when": "'${ secrets.X }' in body.v", "error": "may only be compared with '=='"},
    {"name": "reference mixed with text is refused", "when": "body.v == 'id-${ customer_secrets.X }'", "error": "must be the whole literal"},
    {"name": "jinja indirection is refused", "when": "body.v == '${ customer_secrets.{{ params.n }} }'", "error": "must be the whole literal"},
    {"name": "jinja expression is refused", "when": "body.v == '{{ params.a | upper }}'", "error": "must be the whole literal"},
    {"name": "literal first with == is refused", "when": "'ping' == body.type", "error": "write the request value first"},
    {"name": "two refs are refused", "when": "body.a == body.b", "error": "one request value with one quoted literal"},
    {"name": "two literals are refused", "when": "'a' == 'a'", "error": "one request value with one quoted literal"},
    {"name": "unknown root", "when": "cookie.a == 'b'", "error": "unknown root"},
    {"name": "unknown operator", "when": "body.a != 'b'", "error": "unexpected character"},
    {"name": "and is not supported", "when": "body.a == 'b' and body.c == 'd'", "error": "unexpected text after the condition"},
    {"name": "number literal is refused", "when": "body.a == 1", "error": "unexpected character"},
    {"name": "bare word literal is refused", "when": "body.a == ping", "error": "unknown root"},
    {"name": "unterminated string", "when": "body.a == 'b", "error": "unterminated string"},
    {"name": "unsupported escape", "when": "body.a == 'b\\n'", "error": "unsupported escape"},
    {"name": "method takes no keys", "when": "method.x == 'GET'", "error": "'method' takes no keys"},
    {"name": "header needs one key", "when": "header == 'x'", "error": "'header' takes exactly one key"},
    {"name": "header takes no nested keys", "when": "header['a'].b == 'x'", "error": "'header' takes exactly one key"},
    {"name": "unquoted bracket key", "when": "body[0] == 'x'", "error": "expected a quoted key"},
    {"name": "missing operand", "when": "body.a ==", "error": "expected a request value or a quoted literal"},
    {"name": "missing operator", "when": "body.a 'b'", "error": "expected '==' or 'in'"},
    {"name": "length is measured in UTF-8 bytes", "when": "body.a == '测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测测'", "error": "longer than"},
    {"name": "ASCII whitespace is accepted", "when": "\tmethod \r\n== \u000b'GET'\f", "request": {"method": "GET"}, "match": true},
    {"name": "Unicode whitespace in a literal is preserved", "when": "body.value == 'a\u00a0b'", "request": {"body": {"value": "a\u00a0b"}}, "match": true},
    {"name": "leading Unicode whitespace is refused", "when": "\u2003method == 'GET'", "error": "unexpected character"},
    {"name": "Unicode whitespace between tokens is refused", "when": "method\u00a0== 'GET'", "error": "unexpected character"},
    {"name": "Unicode whitespace before a literal is refused", "when": "method ==\u2003'GET'", "error": "unexpected character"},
    {"name": "trailing Unicode whitespace is refused", "when": "method == 'GET'\u00a0", "error": "unexpected character"},
    {"name": "Unicode whitespace in a secret slot is refused", "when": "body.id == '${\u00a0customer_secrets.HOOK ?? }'", "error": "must be the whole literal"},
    {"name": "Unicode whitespace in a param slot is refused", "when": "body.id == '{{\u00a0params.VAR }}'", "error": "must be the whole literal"},
    {"name": "a newline after a secret reference is refused", "when": "body.id == '${ customer_secrets.HOOK ?? }\n'", "error": "must be the whole literal"},
    {"name": "a newline after a param reference is refused", "when": "body.id == '{{ params.VAR }}\n'", "error": "must be the whole literal"},
    {"name": "a newline after an enrollment reference is refused", "when": "body.id == '{{ enrollment.code }}\n'", "error": "must be the whole literal"},
    {"name": "empty condition", "when": "   ", "error": "non-empty string"}
  ]
}
