  "upstream_access_config": {
    "base": {
      "access_method": "container",
      "description": "One WeChat bot account",
      "resources": {
        "limits": {
          "cpu": "250m",
          "memory": "256Mi",
          "ephemeral-storage": "1Gi"
        }
      },
      "entries": [
        {
          "name": "api",
          "service": "gateway",
          "port": 3000,
          "auth": "app"
        }
      ],
      "params": {
        "schema": {
          "type": "object",
          "properties": {
            "webhook_urls": {
              "type": "string",
              "description": "Comma-separated URLs that receive incoming messages"
            }
          }
        },
        "testing_defaults": {
          "webhook_urls": ""
        }
      },
      "customer_access_requests": [
        {
          "object": "resource:container",
          "permissions": [
            "create"
          ],
          "required": true,
          "justification": "Run one gateway instance for this enrollment"
        }
      ],
      "environment": {
        "gateway": {
          "API_KEY": "change-me-at-least-12-chars"
        }
      }
    }
  },
  "time_created": "2026-01-01T00:00:00Z",
  "description": "Runs the open-source weixin-ilink-gateway straight from its own docker-compose.yaml (pinned by URL and hash), with UnitySVC's API key supplied by an overlay."
