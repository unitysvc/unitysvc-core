{
  "services": [
    {
      "args": [
        "-listen=:5678",
        "-text=healthy"
      ],
      "env": {},
      "health": {
        "command": [
          "/http-echo",
          "-version"
        ],
        "failure_threshold": 3,
        "period_seconds": 5,
        "start_period_seconds": 10,
        "timeout_seconds": 2,
        "type": "exec"
      },
      "image": "docker.io/hashicorp/http-echo@sha256:fcb75f691c8b0414d670ae570240cbf95502cc18a9ba57e982ecac589760a186",
      "name": "web",
      "ports": [
        5678
      ],
      "replicas": 1,
      "resources": {
        "limits": {
          "cpu": "1",
          "ephemeral-storage": "2Gi",
          "memory": "1Gi"
        },
        "requests": {
          "cpu": "1",
          "ephemeral-storage": "2Gi",
          "memory": "1Gi"
        }
      }
    }
  ]
}
